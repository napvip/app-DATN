rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'admin@beeguard.com';
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();

      // Bài viết người dùng đã lưu (tab "Đã lưu" trong app)
      match /saved_articles/{articleId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Bài viết cẩm nang: ai đăng nhập cũng đọc được; chỉ admin tạo/sửa/xoá.
    match /articles/{articleId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /service_bookings/{bookingId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow read, write: if isAdmin();
    }

    match /conversations/{convId} {
      allow read, write: if isAdmin();
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;

      match /messages/{msgId} {
        allow read, write: if isAdmin();
        allow read, write: if request.auth != null
          && request.auth.uid ==
            get(/databases/$(database)/documents/conversations/$(convId)).data.userId;
      }
    }

    match /technicians/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

  }
}
